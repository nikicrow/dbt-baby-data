# Connection used by scripts/load_to_database.py (and therefore ingest.py and
# run_pipeline.py). Copy to .env and fill in DB_PASSWORD.
#
# These same variables are what .github/workflows/dbt-ci.yml sets to point the
# load step at its throwaway Postgres service container — env vars win over
# this file, so CI needs no .env at all.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=baby_data
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=disable
DB_SCHEMA=public
