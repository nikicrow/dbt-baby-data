# Optional. With ~/.dbt/profiles.yml set up, baby_ml reads the fedora_readonly
# target from it and needs none of this. Copy to ml/.env (gitignored) only to
# override — e.g. to point at a different port or database.
#
# ML_DB_HOST=localhost
# ML_DB_PORT=5433
# ML_DB_NAME=baby_data
# ML_DB_USER=readonly
# ML_DB_PASSWORD=
