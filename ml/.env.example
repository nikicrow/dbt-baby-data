# Copy to ml/.env (gitignored) and fill in what you need.
#
# Database: optional. With ~/.dbt/profiles.yml set up, baby_ml reads the
# fedora_readonly target from it; set these only to override it.
#
# ML_DB_HOST=localhost
# ML_DB_PORT=5433
# ML_DB_NAME=baby_data
# ML_DB_USER=readonly
# ML_DB_PASSWORD=

# Required for the Jev comparison (baby_ml.jev). Get a key at
# https://console.typesafe.ai/keys and put it in ml/.env — never in git.
# TYPESAFE_API_KEY=
